rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & ROLE-BASED ACCESS CONTROL (RBAC)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based authorization via Firebase Auth Custom Claims
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' || 
        request.auth.token.role == 'staff' || 
        request.auth.token.role == 'agent'
      );
    }

    // =========================================================================
    // DEFAULT RULE: ZERO-TRUST DENY ALL
    // Any collection not explicitly matched below is completely inaccessible.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. VISA APPLICATIONS & APPLICANT DATA
    // Sensitive passport data, personal records, travel history.
    // ZERO PUBLIC ACCESS.
    // =========================================================================
    match /visa_applications/{applicationId} {
      // Only authenticated applicant or authorized agency staff/admin can read
      allow read: if isStaff() || isOwner(resource.data.userId);

      // Authenticated applicant can submit their own application
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['fullName', 'passportNumber', 'destinationCountry', 'contactPhone']);

      // Applicants can update their own drafts before review; staff can update status
      allow update: if isStaff() || (
        isOwner(resource.data.userId) && 
        resource.data.status == 'draft' &&
        request.resource.data.userId == request.auth.uid
      );

      // Only agency administrator can delete application records
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. CUSTOMER PROFILES & KYC / PASSPORT VAULT
    // Customer profile info, passport scans references, CNIC, etc.
    // ZERO PUBLIC ACCESS.
    // =========================================================================
    match /customers/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. CONTACT LEADS & PUBLIC INQUIRIES
    // Form submissions from the website contact form.
    // Public can write (submit inquiry), but NEVER read any leads or customer info.
    // =========================================================================
    match /inquiries/{inquiryId} {
      // Public cannot read existing inquiries (protects against scraping/data leaks)
      allow read: if isStaff();

      // Anyone (or authenticated user) can submit a lead with strict schema validation
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 100
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 7
                    && request.resource.data.phone.size() <= 20
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 2000;

      // Inquiries cannot be updated or deleted by anyone except authorized staff
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. PACKAGES & PUBLIC MARKETING DATA (READ-ONLY FOR PUBLIC)
    // Destination info, tour packages, FAQ data.
    // =========================================================================
    match /packages/{packageId} {
      allow read: if true; // Public can view travel packages
      allow write: if isStaff(); // Only staff can modify packages
    }

    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
