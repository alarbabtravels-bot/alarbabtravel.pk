{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)malaysia" }
      ],
      "destination": "/destinations/malaysia",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)thailand" }
      ],
      "destination": "/destinations/thailand",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)singapore" }
      ],
      "destination": "/destinations/singapore",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)indonesia" }
      ],
      "destination": "/destinations/indonesia",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)saudi" }
      ],
      "destination": "/destinations/saudi-arabia",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)turkey" }
      ],
      "destination": "/destinations/turkey",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)dubai|uae" }
      ],
      "destination": "/destinations/uae",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)schengen" }
      ],
      "destination": "/destinations/schengen",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)uk" }
      ],
      "destination": "/destinations/uk",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)usa" }
      ],
      "destination": "/destinations/usa",
      "permanent": true
    },
    {
      "source": "/destinations",
      "has": [
        { "type": "query", "key": "search", "value": "(?i)canada" }
      ],
      "destination": "/destinations/canada",
      "permanent": true
    },
    {
      "source": "/destinations/saudi",
      "destination": "/destinations/saudi-arabia",
      "permanent": true
    },
    {
      "source": "/services/hotels",
      "destination": "/services/hotel-booking",
      "permanent": true
    },
    {
      "source": "/services/tours",
      "destination": "/services/group-corporate-travel",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
